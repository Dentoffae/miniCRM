# Скопируйте в .env и подставьте свои значения. Не коммитьте .env в репозиторий.

# --- Мини-CRM GUI / seed_crm_demo (опционально) ---
# CRM_API_BASE_URL=http://127.0.0.1:8080
# CRM_GOOGLE_SYNC=0
# CRM_GOOGLE_TAB_CLIENTS=CRM_Clients
# CRM_GOOGLE_TAB_DEALS=CRM_Deals
# CRM_GOOGLE_TAB_TASKS=CRM_Tasks

# --- CRM → Google Sheets (сервисный аккаунт): одна таблица, листы по умолчанию CRM_Clients / CRM_Deals / CRM_Tasks ---
GOOGLE_SPREADSHEET_ID=<YOUR_GOOGLE_SPREADSHEET_ID>
# Путь от корня проекта (папка EXCEL), например: google/your-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=google/<YOUR_SERVICE_ACCOUNT_KEY>.json

# Опционально: ID папки Drive (для утилит / списка файлов)
GOOGLE_DRIVE_FOLDER_ID=<YOUR_DRIVE_FOLDER_ID>

# OAuth (личный аккаунт) для GoogleDriveOAuthClient — JSON Client secret из Google Cloud Console (Desktop)
GOOGLE_OAUTH_CLIENT_SECRETS=client_secret_<YOUR_CLIENT_ID>.apps.googleusercontent.com.json
# Файл токена (создаётся после первого входа); путь относительно папки google/ или абсолютный
GOOGLE_OAUTH_TOKEN_PATH=token.json
